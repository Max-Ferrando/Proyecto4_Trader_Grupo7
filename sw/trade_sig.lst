                    # Proyecto 4 - Pochoco Trader - Grupo 7
                    # VARIANTE DE CO-DISENO "sig": mismo algoritmo que sw/trade.s, pero
                    # rtl/pochoco_mavg.v (con POCHOCO_MAVG_SIG) mantiene las ventanas moviles y
                    # entrega las dos senales ya combinadas:
                    #   MR    = 60*precio - suma_60      TREND = 6*suma_20 - suma_120
                    # El Espino sigue leyendo el precio por SPI, comparando con los umbrales,
                    # aplicando stop/cooldown/filtro de saltos y escribiendo DECISION.
                    # Sintetizar con make VARIANTE=sig. Toma las mismas decisiones que sw/trade.s.
                    .equ S,       20
                    .equ L,       120
                    .equ LM,      60
                    .equ ENTRY,   4
                    .equ EXIT,    2
                    .equ M2,      4
                    .equ TIN,     4
                    .equ STOP,    8
                    .equ COOL,    64
                    .equ SHOCK,   32             # salto de precio: abstenerse durante cooldown
                    .equ STATE,   0x5F4
                    .equ MAVG,    0x80020000     # periferico de sumas moviles (rtl/pochoco_mavg.v)
                    .equ SPI,     0x80010000
                    .equ PERIPH,  0x80000000
                    
                    # s0 = SPI; s1 = maximo desde entrada; tp = cooldown restante
                    # sp = objetivo anterior (0 fuera, 1 comprado); gp = byte de decision
                    # a2/a3 = libres; a4 = base del periferico; a5 = calentamiento
                    # a0 = precio; ra = precio anterior; t0/t1/t2/a1 = temporales
                    start:
00000000  80010437      li   s0, SPI
00000004  00000493      li   s1, 0
00000008  00000213      li   tp, 0
0000000c  00000193      li   gp, 0
00000010  00000613      li   a2, 0
00000014  00000693      li   a3, 0
00000018  80020737      li   a4, MAVG
0000001c  00000793      li   a5, 0
00000020  00000113      li   sp, 0
00000024  00000093      li   ra, 0
00000028  5e002a23      sw   zero, STATE(zero)
0000002c  00042423      sw   zero, 8(s0)                # DECISION = mantener
                    
                    wait:                               # 1) esperar precio
00000030  00042283      lw   t0, 0(s0)                  # STATUS
00000034  0012f293      andi t0, t0, 1
00000038  fe028ce3      beqz t0, wait
0000003c  00442503      lw   a0, 4(s0)                  # PRICE (leerlo baja el bit de precio nuevo)
                    
                    # Ventanas moviles en hardware: basta entregar el precio al periferico.
                    update:
00000040  00a72023      sw   a0, 0(a4)                  # PUSH precio
00000044  07800313      li   t1, L
00000048  00678a63      beq  a5, t1, signal
0000004c  00178793      addi a5, a5, 1
00000050  00678663      beq  a5, t1, signal
00000054  00000193      li   gp, 0
00000058  0d40006f      j    out
                    
                    # Reversion: d = 60*p - suma_60, calculada por el periferico.
                    signal:
0000005c  00472283      lw   t0, 4(a4)                  # MR (valida desde C2)
00000060  5f402583      lw   a1, STATE(zero)
00000064  f1000313      li   t1, -TIN * LM
00000068  0062d663      bge  t0, t1, mr_not_low
0000006c  0025e593      ori  a1, a1, 2
00000070  00c0006f      j    mr_done
                    mr_not_low:
00000074  00505463      ble  t0, zero, mr_done
00000078  0015f593      andi a1, a1, 1
                    mr_done:
                    # Tendencia: diff = 6*suma_20 - suma_120, calculada por el periferico.
0000007c  00072283      lw   t0, 0(a4)                  # TREND (valida desde C4)
00000080  1e000313      li   t1, ENTRY * L
00000084  00535663      ble  t0, t1, tr_not_up
00000088  0015e593      ori  a1, a1, 1
0000008c  0100006f      j    tr_done
                    tr_not_up:
00000090  f1000313      li   t1, -EXIT * L
00000094  0062d463      bge  t0, t1, tr_done
00000098  0025f593      andi a1, a1, 2
                    tr_done:
0000009c  5eb02a23      sw   a1, STATE(zero)
000000a0  0015f393      andi t2, a1, 1
000000a4  00039c63      bnez t2, risk
000000a8  e2000313      li   t1, -M2 * L
000000ac  0062c863      blt  t0, t1, risk
000000b0  0025f313      andi t1, a1, 2
000000b4  00030463      beqz t1, risk
000000b8  00100393      li   t2, 1
                    
                    # t2 = objetivo candidato; sp = objetivo del tick previo.
                    # Stop relativo al maximo de precio observado desde la entrada de la senal.
                    # No garantiza precio de salida: la orden se ejecuta al precio siguiente.
                    risk:
000000bc  00020463      beqz tp, check_peak
000000c0  fff20213      addi tp, tp, -1
                    check_peak:
000000c4  02010263      beqz sp, enforce_cool
000000c8  00a4d463      bge  s1, a0, check_stop
000000cc  00050493      mv   s1, a0
                    check_stop:
000000d0  40a482b3      sub  t0, s1, a0
000000d4  00800313      li   t1, STOP
000000d8  0062c863      blt  t0, t1, enforce_cool
000000dc  04000213      li   tp, COOL
000000e0  5e002a23      sw   zero, STATE(zero)
000000e4  00000393      li   t2, 0
                    enforce_cool:
000000e8  00020463      beqz tp, new_entry
000000ec  00000393      li   t2, 0
                    new_entry:
000000f0  00038663      beqz t2, decide
000000f4  00011463      bnez sp, decide
000000f8  00050493      mv   s1, a0
                    decide:
                        # Si el ultimo salto fue extremo, no perseguir el precio ni comprar el dip.
000000fc  401502b3      sub  t0, a0, ra
00000100  02000313      li   t1, SHOCK
00000104  0062d663      bge  t0, t1, shock
00000108  fe000313      li   t1, -SHOCK
0000010c  00534863      blt  t1, t0, no_shock
                    shock:
00000110  04000213      li   tp, COOL
00000114  5e002a23      sw   zero, STATE(zero)
00000118  00000393      li   t2, 0
                    no_shock:
0000011c  00038113      mv   sp, t2
00000120  0bf00193      li   gp, 0xBF                  # vender hasta 63; si no hay acciones, no-op
00000124  00010463      beqz sp, out
00000128  07f00193      li   gp, 0x7F                  # comprar hasta 63; la maestra limita a caja
                    out:
0000012c  00342423      sw   gp, 8(s0)
00000130  00050093      mv   ra, a0
00000134  80000337      li   t1, PERIPH
00000138  00a32023      sw   a0, 0(t1)
0000013c  00010393      mv   t2, sp
00000140  0c01f293      andi t0, gp, 0xC0
00000144  04000593      li   a1, 0x40
00000148  00b29463      bne  t0, a1, led_s
0000014c  0023e393      ori  t2, t2, 2
                    led_s:
00000150  08000593      li   a1, 0x80
00000154  00b29463      bne  t0, a1, led_w
00000158  0043e393      ori  t2, t2, 4
                    led_w:
0000015c  00732223      sw   t2, 4(t1)
00000160  ed1ff06f      j    wait
