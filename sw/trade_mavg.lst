                    # Proyecto 4 - Pochoco Trader - Grupo 7
                    # VARIANTE DE CO-DISENO "mavg": mismo algoritmo que sw/trade.s, pero las tres
                    # sumas moviles (20, 60 y 120 precios) las mantiene rtl/pochoco_mavg.v.
                    # El Espino sigue leyendo el precio por SPI, decidiendo y escribiendo DECISION.
                    # Sintetizar con make VARIANTE=mavg. Toma las mismas decisiones que sw/trade.s.
                    .equ S,       20
                    .equ L,       120
                    .equ LM,      60
                    .equ ENTRY,   4
                    .equ EXIT,    2
                    .equ M2,      4
                    .equ TIN,     4
                    .equ STOP,    8
                    .equ COOL,    64
                    .equ SHOCK,   32             # salto de precio: abstenerse durante cooldown
                    .equ STATE,   0x5F4
                    .equ MAVG,    0x80020000     # periferico de sumas moviles (rtl/pochoco_mavg.v)
                    .equ SPI,     0x80010000
                    .equ PERIPH,  0x80000000
                    
                    # s0 = SPI; s1 = maximo desde entrada; tp = cooldown restante
                    # sp = objetivo anterior (0 fuera, 1 comprado); gp = byte de decision
                    # a2/a3 = sumas S/L (leidas del periferico); a4 = base del periferico; a5 = calentamiento
                    # a0 = precio; ra = precio anterior; t0/t1/t2/a1 = temporales
                    start:
00000000  80010437      li   s0, SPI
00000004  00000493      li   s1, 0
00000008  00000213      li   tp, 0
0000000c  00000193      li   gp, 0
00000010  00000613      li   a2, 0
00000014  00000693      li   a3, 0
00000018  80020737      li   a4, MAVG
0000001c  00000793      li   a5, 0
00000020  00000113      li   sp, 0
00000024  00000093      li   ra, 0
00000028  5e002a23      sw   zero, STATE(zero)
0000002c  00042423      sw   zero, 8(s0)                # DECISION = mantener
                    
                    wait:                               # 1) esperar precio
00000030  00042283      lw   t0, 0(s0)                  # STATUS
00000034  0012f293      andi t0, t0, 1
00000038  fe028ce3      beqz t0, wait
0000003c  00442503      lw   a0, 4(s0)                  # PRICE (leerlo baja el bit de precio nuevo)
                    
                    # Ventanas moviles en hardware: basta entregar el precio al periferico.
                    update:
00000040  00a72023      sw   a0, 0(a4)                  # PUSH precio
00000044  07800313      li   t1, L
00000048  00678a63      beq  a5, t1, signal
0000004c  00178793      addi a5, a5, 1
00000050  00678663      beq  a5, t1, signal
00000054  00000193      li   gp, 0
00000058  1080006f      j    out
                    
                    # Reversion: d = 60*p - suma_60. 60*p = (16*p - p)*4.
                    # Las constantes 20/120/60 son fijas para las cadenas de sumas.
                    signal:
0000005c  00a502b3      add  t0, a0, a0
00000060  005282b3      add  t0, t0, t0
00000064  005282b3      add  t0, t0, t0
00000068  005282b3      add  t0, t0, t0
0000006c  40a282b3      sub  t0, t0, a0
00000070  005282b3      add  t0, t0, t0
00000074  005282b3      add  t0, t0, t0
00000078  00472303      lw   t1, 4(a4)                  # SUM60 (primera lectura: valida desde C2)
0000007c  406282b3      sub  t0, t0, t1
00000080  5f402583      lw   a1, STATE(zero)
00000084  f1000313      li   t1, -TIN * LM
00000088  0062d663      bge  t0, t1, mr_not_low
0000008c  0025e593      ori  a1, a1, 2
00000090  00c0006f      j    mr_done
                    mr_not_low:
00000094  00505463      ble  t0, zero, mr_done
00000098  0015f593      andi a1, a1, 1
                    mr_done:
                    # Tendencia: diff = 6*suma_20 - suma_120 = 120*(media20-media120).
0000009c  00072603      lw   a2, 0(a4)                  # SUM20
000000a0  00872683      lw   a3, 8(a4)                  # SUM120
000000a4  00c602b3      add  t0, a2, a2
000000a8  00c28333      add  t1, t0, a2
000000ac  006302b3      add  t0, t1, t1
000000b0  40d282b3      sub  t0, t0, a3
000000b4  1e000313      li   t1, ENTRY * L
000000b8  00535663      ble  t0, t1, tr_not_up
000000bc  0015e593      ori  a1, a1, 1
000000c0  0100006f      j    tr_done
                    tr_not_up:
000000c4  f1000313      li   t1, -EXIT * L
000000c8  0062d463      bge  t0, t1, tr_done
000000cc  0025f593      andi a1, a1, 2
                    tr_done:
000000d0  5eb02a23      sw   a1, STATE(zero)
000000d4  0015f393      andi t2, a1, 1
000000d8  00039c63      bnez t2, risk
000000dc  e2000313      li   t1, -M2 * L
000000e0  0062c863      blt  t0, t1, risk
000000e4  0025f313      andi t1, a1, 2
000000e8  00030463      beqz t1, risk
000000ec  00100393      li   t2, 1
                    
                    # t2 = objetivo candidato; sp = objetivo del tick previo.
                    # Stop relativo al maximo de precio observado desde la entrada de la senal.
                    # No garantiza precio de salida: la orden se ejecuta al precio siguiente.
                    risk:
000000f0  00020463      beqz tp, check_peak
000000f4  fff20213      addi tp, tp, -1
                    check_peak:
000000f8  02010263      beqz sp, enforce_cool
000000fc  00a4d463      bge  s1, a0, check_stop
00000100  00050493      mv   s1, a0
                    check_stop:
00000104  40a482b3      sub  t0, s1, a0
00000108  00800313      li   t1, STOP
0000010c  0062c863      blt  t0, t1, enforce_cool
00000110  04000213      li   tp, COOL
00000114  5e002a23      sw   zero, STATE(zero)
00000118  00000393      li   t2, 0
                    enforce_cool:
0000011c  00020463      beqz tp, new_entry
00000120  00000393      li   t2, 0
                    new_entry:
00000124  00038663      beqz t2, decide
00000128  00011463      bnez sp, decide
0000012c  00050493      mv   s1, a0
                    decide:
                        # Si el ultimo salto fue extremo, no perseguir el precio ni comprar el dip.
00000130  401502b3      sub  t0, a0, ra
00000134  02000313      li   t1, SHOCK
00000138  0062d663      bge  t0, t1, shock
0000013c  fe000313      li   t1, -SHOCK
00000140  00534863      blt  t1, t0, no_shock
                    shock:
00000144  04000213      li   tp, COOL
00000148  5e002a23      sw   zero, STATE(zero)
0000014c  00000393      li   t2, 0
                    no_shock:
00000150  00038113      mv   sp, t2
00000154  0bf00193      li   gp, 0xBF                  # vender hasta 63; si no hay acciones, no-op
00000158  00010463      beqz sp, out
0000015c  07f00193      li   gp, 0x7F                  # comprar hasta 63; la maestra limita a caja
                    out:
00000160  00342423      sw   gp, 8(s0)
00000164  00050093      mv   ra, a0
00000168  80000337      li   t1, PERIPH
0000016c  00a32023      sw   a0, 0(t1)
00000170  00010393      mv   t2, sp
00000174  0c01f293      andi t0, gp, 0xC0
00000178  04000593      li   a1, 0x40
0000017c  00b29463      bne  t0, a1, led_s
00000180  0023e393      ori  t2, t2, 2
                    led_s:
00000184  08000593      li   a1, 0x80
00000188  00b29463      bne  t0, a1, led_w
0000018c  0043e393      ori  t2, t2, 4
                    led_w:
00000190  00732223      sw   t2, 4(t1)
00000194  e9dff06f      j    wait
