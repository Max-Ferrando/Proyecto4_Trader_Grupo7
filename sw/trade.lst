                    # Proyecto 4 - Pochoco Trader - Grupo 7
                    # Hibrido con trailing stop y cooldown. Solo usa precios ya recibidos.
                    # Referencia: algo/trade_ref.py. El testbench oficial ejecuta la orden
                    # al precio del tick siguiente y limita q a caja/acciones disponibles.
                    # Por eso enviamos q=63 en direccion objetivo: la maestra ajusta el fill.
                    # Si no hay caja/acciones suficientes para una unidad, no hay orden ni fee.
                    # No se guardan series ni se modifica RTL, reloj ni protocolo SPI.
                    # RV32E: sin MUL, DIV ni shifts (deshabilitados en el Espino).
                    .equ S,       20
                    .equ L,       120
                    .equ LM,      60
                    .equ ENTRY,   4
                    .equ EXIT,    2
                    .equ M2,      4
                    .equ TIN,     4
                    .equ STOP,    8
                    .equ COOL,    64
                    .equ SHOCK,   32             # salto de precio: abstenerse durante cooldown
                    .equ LBYTES,  4 * L
                    .equ SOFF,    4 * (L - S)
                    .equ MOFF,    4 * (L - LM)
                    .equ SUMM,    0x5F0
                    .equ STATE,   0x5F4
                    .equ BUF,     0x600
                    .equ SPI,     0x80010000
                    .equ PERIPH,  0x80000000
                    
                    # s0 = SPI; s1 = maximo desde entrada; tp = cooldown restante
                    # sp = objetivo anterior (0 fuera, 1 comprado); gp = byte de decision
                    # a2/a3 = sumas S/L; a4 = indice en bytes; a5 = calentamiento
                    # a0 = precio; ra = precio anterior; t0/t1/t2/a1 = temporales
                    start:
00000000  80010437      li   s0, SPI
00000004  00000493      li   s1, 0
00000008  00000213      li   tp, 0
0000000c  00000193      li   gp, 0
00000010  00000613      li   a2, 0
00000014  00000693      li   a3, 0
00000018  00000713      li   a4, 0
0000001c  00000793      li   a5, 0
00000020  00000113      li   sp, 0
00000024  00000093      li   ra, 0
00000028  00000293      li   t0, 0
0000002c  1e000313      li   t1, LBYTES
                    clear:
00000030  6002a023      sw   zero, BUF(t0)
00000034  00428293      addi t0, t0, 4
00000038  fe629ce3      bne  t0, t1, clear
0000003c  5e002823      sw   zero, SUMM(zero)
00000040  5e002a23      sw   zero, STATE(zero)
00000044  00042423      sw   zero, 8(s0)                # DECISION = mantener
                    
                    wait:                               # 1) esperar precio
00000048  00042283      lw   t0, 0(s0)                  # STATUS
0000004c  0012f293      andi t0, t0, 1
00000050  fe028ce3      beqz t0, wait
00000054  00442503      lw   a0, 4(s0)                  # PRICE (leerlo baja el bit de precio nuevo)
                    
                    # Ventanas circulares: O(1) por tick, no se recorre el historial.
                    update:
00000058  60072283      lw   t0, BUF(a4)
0000005c  405502b3      sub  t0, a0, t0
00000060  005686b3      add  a3, a3, t0
00000064  19070393      addi t2, a4, SOFF
00000068  1e000313      li   t1, LBYTES
0000006c  0063c463      blt  t2, t1, s_ok
00000070  406383b3      sub  t2, t2, t1
                    s_ok:
00000074  6003a283      lw   t0, BUF(t2)
00000078  405502b3      sub  t0, a0, t0
0000007c  00560633      add  a2, a2, t0
00000080  0f070393      addi t2, a4, MOFF
00000084  0063c463      blt  t2, t1, m_ok
00000088  406383b3      sub  t2, t2, t1
                    m_ok:
0000008c  6003a283      lw   t0, BUF(t2)
00000090  405502b3      sub  t0, a0, t0
00000094  5f002383      lw   t2, SUMM(zero)
00000098  005383b3      add  t2, t2, t0
0000009c  5e702823      sw   t2, SUMM(zero)
000000a0  60a72023      sw   a0, BUF(a4)
000000a4  00470713      addi a4, a4, 4
000000a8  00671463      bne  a4, t1, idx_ok
000000ac  00000713      li   a4, 0
                    idx_ok:
000000b0  07800313      li   t1, L
000000b4  00678a63      beq  a5, t1, signal
000000b8  00178793      addi a5, a5, 1
000000bc  00678663      beq  a5, t1, signal
000000c0  00000193      li   gp, 0
000000c4  1000006f      j    out
                    
                    # Reversion: d = 60*p - suma_60. 60*p = (16*p - p)*4.
                    # Las constantes 20/120/60 son fijas para las cadenas de sumas.
                    signal:
000000c8  00a502b3      add  t0, a0, a0
000000cc  005282b3      add  t0, t0, t0
000000d0  005282b3      add  t0, t0, t0
000000d4  005282b3      add  t0, t0, t0
000000d8  40a282b3      sub  t0, t0, a0
000000dc  005282b3      add  t0, t0, t0
000000e0  005282b3      add  t0, t0, t0
000000e4  5f002303      lw   t1, SUMM(zero)
000000e8  406282b3      sub  t0, t0, t1
000000ec  5f402583      lw   a1, STATE(zero)
000000f0  f1000313      li   t1, -TIN * LM
000000f4  0062d663      bge  t0, t1, mr_not_low
000000f8  0025e593      ori  a1, a1, 2
000000fc  00c0006f      j    mr_done
                    mr_not_low:
00000100  00505463      ble  t0, zero, mr_done
00000104  0015f593      andi a1, a1, 1
                    mr_done:
                    # Tendencia: diff = 6*suma_20 - suma_120 = 120*(media20-media120).
00000108  00c602b3      add  t0, a2, a2
0000010c  00c28333      add  t1, t0, a2
00000110  006302b3      add  t0, t1, t1
00000114  40d282b3      sub  t0, t0, a3
00000118  1e000313      li   t1, ENTRY * L
0000011c  00535663      ble  t0, t1, tr_not_up
00000120  0015e593      ori  a1, a1, 1
00000124  0100006f      j    tr_done
                    tr_not_up:
00000128  f1000313      li   t1, -EXIT * L
0000012c  0062d463      bge  t0, t1, tr_done
00000130  0025f593      andi a1, a1, 2
                    tr_done:
00000134  5eb02a23      sw   a1, STATE(zero)
00000138  0015f393      andi t2, a1, 1
0000013c  00039c63      bnez t2, risk
00000140  e2000313      li   t1, -M2 * L
00000144  0062c863      blt  t0, t1, risk
00000148  0025f313      andi t1, a1, 2
0000014c  00030463      beqz t1, risk
00000150  00100393      li   t2, 1
                    
                    # t2 = objetivo candidato; sp = objetivo del tick previo.
                    # Stop relativo al maximo de precio observado desde la entrada de la senal.
                    # No garantiza precio de salida: la orden se ejecuta al precio siguiente.
                    risk:
00000154  00020463      beqz tp, check_peak
00000158  fff20213      addi tp, tp, -1
                    check_peak:
0000015c  02010263      beqz sp, enforce_cool
00000160  00a4d463      bge  s1, a0, check_stop
00000164  00050493      mv   s1, a0
                    check_stop:
00000168  40a482b3      sub  t0, s1, a0
0000016c  00800313      li   t1, STOP
00000170  0062c863      blt  t0, t1, enforce_cool
00000174  04000213      li   tp, COOL
00000178  5e002a23      sw   zero, STATE(zero)
0000017c  00000393      li   t2, 0
                    enforce_cool:
00000180  00020463      beqz tp, new_entry
00000184  00000393      li   t2, 0
                    new_entry:
00000188  00038663      beqz t2, decide
0000018c  00011463      bnez sp, decide
00000190  00050493      mv   s1, a0
                    decide:
                        # Si el ultimo salto fue extremo, no perseguir el precio ni comprar el dip.
00000194  401502b3      sub  t0, a0, ra
00000198  02000313      li   t1, SHOCK
0000019c  0062d663      bge  t0, t1, shock
000001a0  fe000313      li   t1, -SHOCK
000001a4  00534863      blt  t1, t0, no_shock
                    shock:
000001a8  04000213      li   tp, COOL
000001ac  5e002a23      sw   zero, STATE(zero)
000001b0  00000393      li   t2, 0
                    no_shock:
000001b4  00038113      mv   sp, t2
000001b8  0bf00193      li   gp, 0xBF                  # vender hasta 63; si no hay acciones, no-op
000001bc  00010463      beqz sp, out
000001c0  07f00193      li   gp, 0x7F                  # comprar hasta 63; la maestra limita a caja
                    out:
000001c4  00342423      sw   gp, 8(s0)
000001c8  00050093      mv   ra, a0
000001cc  80000337      li   t1, PERIPH
000001d0  00a32023      sw   a0, 0(t1)
000001d4  00010393      mv   t2, sp
000001d8  0c01f293      andi t0, gp, 0xC0
000001dc  04000593      li   a1, 0x40
000001e0  00b29463      bne  t0, a1, led_s
000001e4  0023e393      ori  t2, t2, 2
                    led_s:
000001e8  08000593      li   a1, 0x80
000001ec  00b29463      bne  t0, a1, led_w
000001f0  0043e393      ori  t2, t2, 4
                    led_w:
000001f4  00732223      sw   t2, 4(t1)
000001f8  e51ff06f      j    wait
