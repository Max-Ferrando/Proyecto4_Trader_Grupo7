                    # =============================================================================
                    # trade.s - Pochoco Trader: agente de inversion para Espino Core (RV32E)
                    # Proyecto 4 - Arquitectura de Computadores 2026-2 - Grupo 7
                    #
                    # Ensamblar:  python3 tools/rvasm.py sw/trade.s -o sw/trade.hex -l sw/trade.lst
                    #
                    # ALGORITMO (cruce de medias moviles, referencia exacta: algo/trade_ref.py)
                    #   * Media corta de S precios y media larga de L precios. Si la corta supera
                    #     a la larga por mas de M (en unidades de precio), el precio viene
                    #     subiendo: quiero estar COMPRADO. Si queda por debajo por mas de M:
                    #     quiero estar FUERA. Entre medio no cambio de opinion (histeresis).
                    #   * Para no dividir se compara L*suma_corta con S*suma_larga.
                    #   * Cantidad: comprado -> compra todo lo que alcance (max. 63 por orden);
                    #     fuera -> vende todo lo que tiene (max. 63 por orden).
                    #   * Parametros elegidos con las dos series de practica (algo/tune_all2.py).
                    #
                    # PROTOCOLO (enunciado 2.2): la orden escrita en DECISION despues de recibir
                    # p[n] la ejecuta la maestra al precio p[n+1]. Por eso al llegar cada precio
                    # primero se aplica la orden pendiente a la copia propia de la contabilidad,
                    # con las mismas reglas que tb/tb_proyecto_4.sv.
                    #
                    # RESTRICCIONES DEL CORE: sin MUL/DIV y con los shifts deshabilitados.
                    #   * x*K constante -> duplicaciones: suma x, 2x, 4x... segun los bits de K.
                    #   * cantidad que alcanza (caja-C)/p -> lazo de sumas de p (afford).
                    #   * n*p de una venta -> lazo de n sumas.
                    #
                    # Mapa de memoria
                    #   0x0000_0000  programa (BRAM de 2 KB)
                    #   0x0000_0600  buffer circular de L precios (palabras de 32 bits)
                    #   0x8000_0000  perifericos: +0 display 7 seg, +4 LEDs, +0xC contador ciclos
                    #   0x8001_0000  SPI: +0 STATUS (bit0 = precio nuevo), +4 PRICE, +8 DECISION
                    #
                    # Registros (todos "globales", no hay pila)
                    #   s0 = base SPI          s1 = caja ($)          tp = acciones
                    #   gp = ultimo byte escrito en DECISION (orden pendiente)
                    #   a2 = suma corta (S)    a3 = suma larga (L)    a4 = indice del buffer (bytes)
                    #   a5 = precios recibidos (satura en L)          sp = 1 quiero estar comprado
                    #   a0 = precio actual     ra = retorno de afford
                    #   t0, t1, t2, a1 = temporales
                    # =============================================================================
                    
                    # ----------------------------- Parametros ------------------------------------
                    .equ S,       20                # ventana corta (ticks)
                    .equ L,       120               # ventana larga (ticks), S < L <= 120
                    .equ M,       8                 # histeresis (unidades de precio)
                    .equ CASH0,   10000             # caja inicial
                    .equ FEE,     5                 # comision por orden ejecutada
                    .equ QMAX,    63                # cantidad maxima por orden
                    
                    .equ THR,     M * S * L         # umbral para L*suma_corta - S*suma_larga
                    .equ LBYTES,  4 * L             # largo del buffer en bytes
                    .equ SOFF,    4 * (L - S)       # desplazamiento al precio de hace S ticks
                    
                    .equ PERIPH,  0x80000000
                    .equ SPI,     0x80010000
                    .equ BUF,     0x600             # cabe en el inmediato de 12 bits de lw/sw
                    
                    .equ ACT_BUY,  0x40
                    .equ ACT_SELL, 0x80
                    
                    # ----------------------------- Inicio ----------------------------------------
                    start:
00000000  80010437      li   s0, SPI
00000004  000024b7      li   s1, CASH0
00000008  71048493  
0000000c  00000213      li   tp, 0
00000010  00000193      li   gp, 0
00000014  00000613      li   a2, 0
00000018  00000693      li   a3, 0
0000001c  00000713      li   a4, 0
00000020  00000793      li   a5, 0
00000024  00000113      li   sp, 0
00000028  00000293      li   t0, 0                      # buffer en cero (la BRAM puede venir con basura)
0000002c  1e000313      li   t1, LBYTES
                    clear:
00000030  6002a023      sw   zero, BUF(t0)
00000034  00428293      addi t0, t0, 4
00000038  fe629ce3      bne  t0, t1, clear
0000003c  00042423      sw   zero, 8(s0)                # DECISION = mantener
                    
                    # ----------------------------- Ciclo principal -------------------------------
                    wait:                               # 1) esperar precio
00000040  00042283      lw   t0, 0(s0)                  # STATUS
00000044  0012f293      andi t0, t0, 1
00000048  fe028ce3      beqz t0, wait
0000004c  00442503      lw   a0, 4(s0)                  # PRICE (leerlo baja el bit de precio nuevo)
                    
                        # 2) aplicar la orden pendiente al precio recien llegado
                    apply:
00000050  03f1f593      andi a1, gp, 63                 # q
00000054  06058063      beqz a1, update
00000058  0c01f293      andi t0, gp, 0xC0
0000005c  04000313      li   t1, ACT_BUY
00000060  00629c63      bne  t0, t1, apply_sell
00000064  178000ef      call afford                     # t0 = n, t1 = costo (FEE + n*p)
00000068  04028663      beqz t0, update
0000006c  406484b3      sub  s1, s1, t1
00000070  00520233      add  tp, tp, t0
00000074  0400006f      j    update
                    apply_sell:
00000078  08000313      li   t1, ACT_SELL
0000007c  02629c63      bne  t0, t1, update             # 0xC0 = reservado = mantener
00000080  00b27463      bgeu tp, a1, sell_n             # n = min(q, acciones)
00000084  00020593      mv   a1, tp
                    sell_n:
00000088  02058663      beqz a1, update
0000008c  00000313      li   t1, 0                      # t1 = n*p con sumas
00000090  00058393      mv   t2, a1
                    sell_mul:
00000094  00a30333      add  t1, t1, a0
00000098  fff38393      addi t2, t2, -1
0000009c  fe039ce3      bnez t2, sell_mul
000000a0  00648333      add  t1, s1, t1                 # caja + n*p
000000a4  00500393      li   t2, FEE
000000a8  00734663      blt  t1, t2, update             # la maestra no vende si caja + n*p < C
000000ac  407304b3      sub  s1, t1, t2
000000b0  40b20233      sub  tp, tp, a1
                    
                        # 3) actualizar las ventanas moviles (buffer circular)
                    update:
000000b4  60072283      lw   t0, BUF(a4)                # precio de hace L ticks (sale de la larga)
000000b8  405502b3      sub  t0, a0, t0
000000bc  005686b3      add  a3, a3, t0
000000c0  19070393      addi t2, a4, SOFF               # precio de hace S ticks (sale de la corta)
000000c4  1e000313      li   t1, LBYTES
000000c8  0063c463      blt  t2, t1, s_ok
000000cc  406383b3      sub  t2, t2, t1
                    s_ok:
000000d0  6003a283      lw   t0, BUF(t2)
000000d4  405502b3      sub  t0, a0, t0
000000d8  00560633      add  a2, a2, t0
000000dc  60a72023      sw   a0, BUF(a4)
000000e0  00470713      addi a4, a4, 4
000000e4  00671463      bne  a4, t1, idx_ok
000000e8  00000713      li   a4, 0
                    idx_ok:
000000ec  07800313      li   t1, L                      # calentamiento: hasta tener L precios
000000f0  00678663      beq  a5, t1, signal
000000f4  00178793      addi a5, a5, 1
000000f8  06679e63      bne  a5, t1, decide
                    
                        # 4) senal: diff = L*suma_corta - S*suma_larga
                        #    Multiplicacion por constante con duplicaciones: recorre los 8 bits de
                        #    la constante con una mascara y suma x, 2x, 4x... (ra se usa como
                        #    registro temporal: aqui no hay ninguna llamada en curso).
                    signal:
000000fc  00000293      li   t0, 0                      # t0 = L * suma_corta
00000100  00060313      mv   t1, a2
00000104  00100393      li   t2, 1
                    mul_l:
00000108  0783f593      andi a1, t2, L
0000010c  00058463      beqz a1, mul_l_next
00000110  006282b3      add  t0, t0, t1
                    mul_l_next:
00000114  00630333      add  t1, t1, t1
00000118  007383b3      add  t2, t2, t2
0000011c  10000593      li   a1, 256
00000120  feb3e4e3      bltu t2, a1, mul_l
00000124  00000093      li   ra, 0                      # ra = S * suma_larga
00000128  00068313      mv   t1, a3
0000012c  00100393      li   t2, 1
                    mul_s:
00000130  0143f593      andi a1, t2, S
00000134  00058463      beqz a1, mul_s_next
00000138  006080b3      add  ra, ra, t1
                    mul_s_next:
0000013c  00630333      add  t1, t1, t1
00000140  007383b3      add  t2, t2, t2
00000144  10000593      li   a1, 256
00000148  feb3e4e3      bltu t2, a1, mul_s
0000014c  401282b3      sub  t0, t0, ra                 # diff
00000150  00005337      li   t1, THR
00000154  b0030313  
00000158  00535663      ble  t0, t1, not_up
0000015c  00100113      li   sp, 1                      # tendencia alcista: quiero estar comprado
00000160  0140006f      j    decide
                    not_up:
00000164  ffffb337      li   t1, -THR
00000168  50030313  
0000016c  0062d463      bge  t0, t1, decide             # dentro de la banda: sin cambio
00000170  00000113      li   sp, 0                      # tendencia bajista: quiero estar fuera
                    
                        # 5) decidir cantidad y escribir DECISION
                    decide:
00000174  00000193      li   gp, 0
00000178  00010c63      beqz sp, dec_sell
0000017c  03f00593      li   a1, QMAX
00000180  05c000ef      call afford
00000184  02028263      beqz t0, out
00000188  0402e193      ori  gp, t0, ACT_BUY
0000018c  01c0006f      j    out
                    dec_sell:
00000190  00020293      mv   t0, tp                     # vender min(63, acciones)
00000194  03f00313      li   t1, QMAX
00000198  00537463      bleu t0, t1, ds_ok
0000019c  00030293      mv   t0, t1
                    ds_ok:
000001a0  00028463      beqz t0, out
000001a4  0802e193      ori  gp, t0, ACT_SELL
                    out:
000001a8  00342423      sw   gp, 8(s0)                  # DECISION
                    
                        # 6) display: precio en hexadecimal; LEDs: 0 = comprado, 1 = compra, 2 = venta
000001ac  80000337      li   t1, PERIPH
000001b0  00a32023      sw   a0, 0(t1)
000001b4  00010393      mv   t2, sp
000001b8  0c01f293      andi t0, gp, 0xC0
000001bc  04000593      li   a1, ACT_BUY
000001c0  00b29463      bne  t0, a1, led_s
000001c4  0023e393      ori  t2, t2, 2
                    led_s:
000001c8  08000593      li   a1, ACT_SELL
000001cc  00b29463      bne  t0, a1, led_w
000001d0  0043e393      ori  t2, t2, 4
                    led_w:
000001d4  00732223      sw   t2, 4(t1)
000001d8  e69ff06f      j    wait
                    
                    # ----------------------------- Subrutina -------------------------------------
                    # afford: mayor n <= a1 tal que FEE + n*p <= caja.
                    #   entrada: a0 = p, a1 = maximo, s1 = caja
                    #   salida:  t0 = n, t1 = FEE + n*p      (usa t2)
                    afford:
000001dc  00000293      li   t0, 0
000001e0  00500313      li   t1, FEE
000001e4  00058c63      beqz a1, aff_end
                    aff_loop:
000001e8  00a303b3      add  t2, t1, a0
000001ec  0074e863      bltu s1, t2, aff_end            # caja < costo con una accion mas
000001f0  00038313      mv   t1, t2
000001f4  00128293      addi t0, t0, 1
000001f8  feb298e3      bne  t0, a1, aff_loop
                    aff_end:
000001fc  00008067      ret
