                    # =============================================================================
                    # trade.s - Pochoco Trader: agente de inversion para Espino Core (RV32E)
                    # Proyecto 4 - Arquitectura de Computadores 2026-2 - Grupo 7
                    #
                    # Ensamblar:  python3 tools/rvasm.py sw/trade.s -o sw/trade.hex -l sw/trade.lst
                    #
                    # ALGORITMO HIBRIDO (referencia exacta: algo/trade_ref.py)
                    #   * Tendencia: media corta (S) contra media larga (L). Si la corta supera a
                    #     la larga por mas de M -> trend = 1; si queda mas de M por debajo -> 0.
                    #   * Reversion a la media: si el precio cae mas de TIN bajo la media de LM
                    #     precios -> mr = 1; si sube mas de TOUT sobre esa media -> mr = 0.
                    #   * Quiero estar COMPRADO si trend, o si mr y no hay bajada fuerte (media
                    #     corta mas de M2 bajo la larga). Si no, quiero estar FUERA.
                    #   * Sin divisiones: se comparan sumas escaladas (L*suma_corta con
                    #     S*suma_larga, y LM*precio con la suma de LM precios).
                    #   * Cantidad: comprado -> compra todo lo que alcance (max. 63 por orden);
                    #     fuera -> vende todo lo que tiene (max. 63 por orden).
                    #   * Parametros elegidos con las dos series de practica.
                    #
                    # PROTOCOLO (enunciado 2.2): la orden escrita en DECISION despues de recibir
                    # p[n] la ejecuta la maestra al precio p[n+1]. Por eso al llegar cada precio
                    # primero se aplica la orden pendiente a la copia propia de la contabilidad,
                    # con las mismas reglas que tb/tb_proyecto_4.sv.
                    #
                    # RESTRICCIONES DEL CORE: sin MUL/DIV y con los shifts deshabilitados.
                    #   * x*K constante -> duplicaciones: suma x, 2x, 4x... segun los bits de K.
                    #   * cantidad que alcanza (caja-C)/p -> lazo de sumas de p (afford).
                    #   * n*p de una venta -> lazo de n sumas.
                    #
                    # Mapa de memoria
                    #   0x0000_0000  programa (BRAM de 2 KB)
                    #   0x0000_05F0  SUMM: suma de los ultimos LM precios   0x5F4 STATE: bit0 trend, bit1 mr
                    #   0x0000_0600  buffer circular de L precios (palabras de 32 bits)
                    #   0x8000_0000  perifericos: +0 display 7 seg, +4 LEDs, +0xC contador ciclos
                    #   0x8001_0000  SPI: +0 STATUS (bit0 = precio nuevo), +4 PRICE, +8 DECISION
                    #
                    # Registros (todos "globales", no hay pila)
                    #   s0 = base SPI          s1 = caja ($)          tp = acciones
                    #   gp = ultimo byte escrito en DECISION (orden pendiente)
                    #   a2 = suma corta (S)    a3 = suma larga (L)    a4 = indice del buffer (bytes)
                    #   a5 = precios recibidos (satura en L)          sp = 1 quiero estar comprado
                    #   a0 = precio actual     ra = retorno de afford
                    #   t0, t1, t2, a1 = temporales
                    # =============================================================================
                    
                    # ----------------------------- Parametros ------------------------------------
                    .equ S,       20                # ventana corta (ticks)
                    .equ L,       120               # ventana larga (ticks), S < L <= 120
                    .equ M,       8                 # histeresis (unidades de precio)
                    .equ LM,      60                # ventana de la reversion a la media (LM <= L)
                    .equ TIN,     4                 # mr = 1 si el precio esta TIN bajo la media LM
                    .equ TOUT,    0                 # mr = 0 si el precio esta TOUT sobre la media LM
                    .equ M2,      4                 # bajada fuerte: corta mas de M2 bajo la larga
                    .equ CASH0,   10000             # caja inicial
                    .equ FEE,     5                 # comision por orden ejecutada
                    .equ QMAX,    63                # cantidad maxima por orden
                    
                    .equ THR,     M * S * L         # umbral para L*suma_corta - S*suma_larga
                    .equ LBYTES,  4 * L             # largo del buffer en bytes
                    .equ SOFF,    4 * (L - S)       # desplazamiento al precio de hace S ticks
                    .equ MOFF,    4 * (L - LM)      # desplazamiento al precio de hace LM ticks
                    .equ THR2,    M2 * S * L        # umbral de bajada fuerte
                    .equ SUMM,    0x5F0
                    .equ STATE,   0x5F4
                    
                    .equ PERIPH,  0x80000000
                    .equ SPI,     0x80010000
                    .equ BUF,     0x600             # cabe en el inmediato de 12 bits de lw/sw
                    
                    .equ ACT_BUY,  0x40
                    .equ ACT_SELL, 0x80
                    
                    # ----------------------------- Inicio ----------------------------------------
                    start:
00000000  80010437      li   s0, SPI
00000004  000024b7      li   s1, CASH0
00000008  71048493  
0000000c  00000213      li   tp, 0
00000010  00000193      li   gp, 0
00000014  00000613      li   a2, 0
00000018  00000693      li   a3, 0
0000001c  00000713      li   a4, 0
00000020  00000793      li   a5, 0
00000024  00000113      li   sp, 0
00000028  00000293      li   t0, 0                      # buffer en cero (la BRAM puede venir con basura)
0000002c  1e000313      li   t1, LBYTES
                    clear:
00000030  6002a023      sw   zero, BUF(t0)
00000034  00428293      addi t0, t0, 4
00000038  fe629ce3      bne  t0, t1, clear
0000003c  5e002823      sw   zero, SUMM(zero)
00000040  5e002a23      sw   zero, STATE(zero)
00000044  00042423      sw   zero, 8(s0)                # DECISION = mantener
                    
                    # ----------------------------- Ciclo principal -------------------------------
                    wait:                               # 1) esperar precio
00000048  00042283      lw   t0, 0(s0)                  # STATUS
0000004c  0012f293      andi t0, t0, 1
00000050  fe028ce3      beqz t0, wait
00000054  00442503      lw   a0, 4(s0)                  # PRICE (leerlo baja el bit de precio nuevo)
                    
                        # 2) aplicar la orden pendiente al precio recien llegado
                    apply:
00000058  03f1f593      andi a1, gp, 63                 # q
0000005c  06058063      beqz a1, update
00000060  0c01f293      andi t0, gp, 0xC0
00000064  04000313      li   t1, ACT_BUY
00000068  00629c63      bne  t0, t1, apply_sell
0000006c  214000ef      call afford                     # t0 = n, t1 = costo (FEE + n*p)
00000070  04028663      beqz t0, update
00000074  406484b3      sub  s1, s1, t1
00000078  00520233      add  tp, tp, t0
0000007c  0400006f      j    update
                    apply_sell:
00000080  08000313      li   t1, ACT_SELL
00000084  02629c63      bne  t0, t1, update             # 0xC0 = reservado = mantener
00000088  00b27463      bgeu tp, a1, sell_n             # n = min(q, acciones)
0000008c  00020593      mv   a1, tp
                    sell_n:
00000090  02058663      beqz a1, update
00000094  00000313      li   t1, 0                      # t1 = n*p con sumas
00000098  00058393      mv   t2, a1
                    sell_mul:
0000009c  00a30333      add  t1, t1, a0
000000a0  fff38393      addi t2, t2, -1
000000a4  fe039ce3      bnez t2, sell_mul
000000a8  00648333      add  t1, s1, t1                 # caja + n*p
000000ac  00500393      li   t2, FEE
000000b0  00734663      blt  t1, t2, update             # la maestra no vende si caja + n*p < C
000000b4  407304b3      sub  s1, t1, t2
000000b8  40b20233      sub  tp, tp, a1
                    
                        # 3) actualizar las ventanas moviles (buffer circular)
                    update:
000000bc  60072283      lw   t0, BUF(a4)                # precio de hace L ticks (sale de la larga)
000000c0  405502b3      sub  t0, a0, t0
000000c4  005686b3      add  a3, a3, t0
000000c8  19070393      addi t2, a4, SOFF               # precio de hace S ticks (sale de la corta)
000000cc  1e000313      li   t1, LBYTES
000000d0  0063c463      blt  t2, t1, s_ok
000000d4  406383b3      sub  t2, t2, t1
                    s_ok:
000000d8  6003a283      lw   t0, BUF(t2)
000000dc  405502b3      sub  t0, a0, t0
000000e0  00560633      add  a2, a2, t0
000000e4  0f070393      addi t2, a4, MOFF               # precio de hace LM ticks (sale de la media LM)
000000e8  0063c463      blt  t2, t1, m_ok
000000ec  406383b3      sub  t2, t2, t1
                    m_ok:
000000f0  6003a283      lw   t0, BUF(t2)
000000f4  405502b3      sub  t0, a0, t0
000000f8  5f002383      lw   t2, SUMM(zero)
000000fc  005383b3      add  t2, t2, t0
00000100  5e702823      sw   t2, SUMM(zero)
00000104  60a72023      sw   a0, BUF(a4)
00000108  00470713      addi a4, a4, 4
0000010c  00671463      bne  a4, t1, idx_ok
00000110  00000713      li   a4, 0
                    idx_ok:
00000114  07800313      li   t1, L                      # calentamiento: hasta tener L precios
00000118  00678663      beq  a5, t1, signal
0000011c  00178793      addi a5, a5, 1
00000120  0e679c63      bne  a5, t1, decide
                    
                        # 4) senal: diff = L*suma_corta - S*suma_larga
                        #    Multiplicacion por constante con duplicaciones: recorre los 8 bits de
                        #    la constante con una mascara y suma x, 2x, 4x... (ra se usa como
                        #    registro temporal: aqui no hay ninguna llamada en curso).
                    signal:
00000124  00000093      li   ra, 0                      # ra = LM * precio
00000128  00050313      mv   t1, a0
0000012c  00100393      li   t2, 1
                    mul_m:
00000130  03c3f593      andi a1, t2, LM
00000134  00058463      beqz a1, mul_m_next
00000138  006080b3      add  ra, ra, t1
                    mul_m_next:
0000013c  00630333      add  t1, t1, t1
00000140  007383b3      add  t2, t2, t2
00000144  10000593      li   a1, 256
00000148  feb3e4e3      bltu t2, a1, mul_m
0000014c  5f002303      lw   t1, SUMM(zero)
00000150  406080b3      sub  ra, ra, t1                 # d = LM*p - suma = LM*(p - media)
00000154  5f402583      lw   a1, STATE(zero)
00000158  f1000313      li   t1, -TIN * LM
0000015c  0060d663      bge  ra, t1, mr_not_low
00000160  0025e593      ori  a1, a1, 2                  # muy bajo la media: mr = 1
00000164  0100006f      j    mr_done
                    mr_not_low:
00000168  00000313      li   t1, TOUT * LM
0000016c  00135463      ble  ra, t1, mr_done
00000170  0015f593      andi a1, a1, 1                  # volvio sobre la media: mr = 0
                    mr_done:
00000174  5eb02a23      sw   a1, STATE(zero)
00000178  00000293      li   t0, 0                      # t0 = L * suma_corta
0000017c  00060313      mv   t1, a2
00000180  00100393      li   t2, 1
                    mul_l:
00000184  0783f593      andi a1, t2, L
00000188  00058463      beqz a1, mul_l_next
0000018c  006282b3      add  t0, t0, t1
                    mul_l_next:
00000190  00630333      add  t1, t1, t1
00000194  007383b3      add  t2, t2, t2
00000198  10000593      li   a1, 256
0000019c  feb3e4e3      bltu t2, a1, mul_l
000001a0  00000093      li   ra, 0                      # ra = S * suma_larga
000001a4  00068313      mv   t1, a3
000001a8  00100393      li   t2, 1
                    mul_s:
000001ac  0143f593      andi a1, t2, S
000001b0  00058463      beqz a1, mul_s_next
000001b4  006080b3      add  ra, ra, t1
                    mul_s_next:
000001b8  00630333      add  t1, t1, t1
000001bc  007383b3      add  t2, t2, t2
000001c0  10000593      li   a1, 256
000001c4  feb3e4e3      bltu t2, a1, mul_s
000001c8  401282b3      sub  t0, t0, ra                 # diff
000001cc  5f402583      lw   a1, STATE(zero)
000001d0  00005337      li   t1, THR
000001d4  b0030313  
000001d8  00535663      ble  t0, t1, tr_not_up
000001dc  0015e593      ori  a1, a1, 1                  # tendencia alcista: trend = 1
000001e0  0140006f      j    tr_done
                    tr_not_up:
000001e4  ffffb337      li   t1, -THR
000001e8  50030313  
000001ec  0062d463      bge  t0, t1, tr_done
000001f0  0025f593      andi a1, a1, 2                  # tendencia bajista: trend = 0
                    tr_done:
000001f4  5eb02a23      sw   a1, STATE(zero)
000001f8  0015f113      andi sp, a1, 1                  # quiero = trend ...
000001fc  00011e63      bnez sp, decide
00000200  ffffe337      li   t1, -THR2
00000204  a8030313  
00000208  0062c863      blt  t0, t1, decide             # bajada fuerte: fuera
0000020c  0025f313      andi t1, a1, 2
00000210  00030463      beqz t1, decide
00000214  00100113      li   sp, 1                      # ... o mr sin bajada fuerte
                    
                        # 5) decidir cantidad y escribir DECISION
                    decide:
00000218  00000193      li   gp, 0
0000021c  00010c63      beqz sp, dec_sell
00000220  03f00593      li   a1, QMAX
00000224  05c000ef      call afford
00000228  02028263      beqz t0, out
0000022c  0402e193      ori  gp, t0, ACT_BUY
00000230  01c0006f      j    out
                    dec_sell:
00000234  00020293      mv   t0, tp                     # vender min(63, acciones)
00000238  03f00313      li   t1, QMAX
0000023c  00537463      bleu t0, t1, ds_ok
00000240  00030293      mv   t0, t1
                    ds_ok:
00000244  00028463      beqz t0, out
00000248  0802e193      ori  gp, t0, ACT_SELL
                    out:
0000024c  00342423      sw   gp, 8(s0)                  # DECISION
                    
                        # 6) display: precio en hexadecimal; LEDs: 0 = comprado, 1 = compra, 2 = venta
00000250  80000337      li   t1, PERIPH
00000254  00a32023      sw   a0, 0(t1)
00000258  00010393      mv   t2, sp
0000025c  0c01f293      andi t0, gp, 0xC0
00000260  04000593      li   a1, ACT_BUY
00000264  00b29463      bne  t0, a1, led_s
00000268  0023e393      ori  t2, t2, 2
                    led_s:
0000026c  08000593      li   a1, ACT_SELL
00000270  00b29463      bne  t0, a1, led_w
00000274  0043e393      ori  t2, t2, 4
                    led_w:
00000278  00732223      sw   t2, 4(t1)
0000027c  dcdff06f      j    wait
                    
                    # ----------------------------- Subrutina -------------------------------------
                    # afford: mayor n <= a1 tal que FEE + n*p <= caja.
                    #   entrada: a0 = p, a1 = maximo, s1 = caja
                    #   salida:  t0 = n, t1 = FEE + n*p      (usa t2)
                    afford:
00000280  00000293      li   t0, 0
00000284  00500313      li   t1, FEE
00000288  00058c63      beqz a1, aff_end
                    aff_loop:
0000028c  00a303b3      add  t2, t1, a0
00000290  0074e863      bltu s1, t2, aff_end            # caja < costo con una accion mas
00000294  00038313      mv   t1, t2
00000298  00128293      addi t0, t0, 1
0000029c  feb298e3      bne  t0, a1, aff_loop
                    aff_end:
000002a0  00008067      ret
